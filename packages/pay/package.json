{
  "name": "@ferry/pay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./migrations": {
      "types": "./src/migrations-fs.ts",
      "default": "./src/migrations-fs.ts"
    },
    "./siws": {
      "types": "./src/siws.ts",
      "default": "./src/siws.ts"
    },
    "./neon": {
      "types": "./src/neon.ts",
      "default": "./src/neon.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "check:schema": "tsx scripts/check-schema.ts"
  },
  "dependencies": {
    "@ferry/core": "workspace:*",
    "@mysten/sui": "2.39.1",
    "@neondatabase/serverless": "1.2.0",
    "@suimpp/mpp": "0.9.0",
    "mppx": "0.4.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "tsx": "4.23.15"
  }
}
