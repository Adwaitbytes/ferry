{
  "name": "@ferry/sdk",
  "version": "0.1.0",
  "description": "Pay a Ferry Share Card per recall in Sui USDC over HTTP 402 (MPP), from any agent.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "ferry",
    "sui",
    "mpp",
    "x402",
    "usdc",
    "agent-payments",
    "memory"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mysten/sui": "2.39.1",
    "@suimpp/mpp": "0.9.0",
    "mppx": "0.4.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@ferry/core": "workspace:*",
    "@ferry/pay": "workspace:*",
    "tsup": "9.0.0"
  }
}
