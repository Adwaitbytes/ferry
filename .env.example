# Every variable Ferry reads. Copy to .env.local and fill in. Never commit real values.

# Tatum: Sui gRPC gateway, price data, storage. Server side only.
TATUM_API_KEY=
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io

# Walrus Memory (Mainnet). Verified in docs/RESEARCH.md.
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f

# Ferry Gate: public profile account. The Gate holds ONLY this account's delegate key.
GATE_PUBLIC_ACCOUNT_ID=
GATE_DELEGATE_PRIVATE_KEY=

# Neon Postgres (pooled). Gate cards, payment replay table, counters. No memory text.
DATABASE_URL=

# LLM providers for Distill and Desk. Server side only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENOKI_API_KEY=

# Session signing for SIWS-style wallet login (32+ random bytes, base64).
SESSION_SECRET=

# Public origin of the web app, used for extension externally_connectable and CSP.
NEXT_PUBLIC_FERRY_WEB_ORIGIN=http://localhost:3000
