# Every variable Ferry reads. Copy to .env.local and fill in. Never commit real values.

# Tatum: Sui gRPC gateway, price data, storage. Server side only.
TATUM_API_KEY=
TATUM_SUI_GRPC_URL=https://sui-mainnet-grpc.gateway.tatum.io
# Tatum issues separate Testnet keys. Used when SUI_NETWORK (or GATE_SUI_NETWORK) is testnet;
# falls back to TATUM_API_KEY, then keyless.
TATUM_API_KEY_TESTNET=
# Network the chain service reads: mainnet (default) or testnet. Leave unset on the web app,
# which reads Walrus Mainnet. The Gate sets it from GATE_SUI_NETWORK.
SUI_NETWORK=

# Walrus Memory (Mainnet). Verified in docs/RESEARCH.md.
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f

# Ferry Gate: public profile account. The Gate holds ONLY this account's delegate key.
GATE_PUBLIC_ACCOUNT_ID=
GATE_DELEGATE_PRIVATE_KEY=
# Sui address that owns the Public profile account. Only this wallet may create cards over it,
# and it is the payment recipient (Ferry never custodies funds).
GATE_PUBLIC_ACCOUNT_OWNER=
# Optional comma list of the user's PRIVATE account ids. The Gate refuses to start if
# GATE_PUBLIC_ACCOUNT_ID is one of them (THREAT_MODEL X-GATE-1).
GATE_PRIVATE_ACCOUNT_IDS=
# HMAC key that binds MPP challenge ids to their terms (32+ random bytes, base64).
GATE_MPP_SECRET_KEY=
# Stable MPP realm, shared by every Gate instance so a challenge verifies anywhere.
GATE_REALM=ferry-gate
# Payment network: mainnet (default) or testnet. Memory is always recalled from Walrus Mainnet;
# only the USDC payment, its verification and explorer links follow this.
GATE_SUI_NETWORK=mainnet
# Fullnode that executes x402 payer-signed transactions (Tatum re-verifies the result).
# Optional: defaults to the public fullnode of GATE_SUI_NETWORK.
SUI_FULLNODE_URL=https://fullnode.mainnet.sui.io:443

# Neon Postgres (pooled). Gate cards, payment replay table, counters. No memory text.
DATABASE_URL=
# Migration role (DDL). Used only by `pnpm --filter @ferry/pay migrate`, never by the Gate (X-DB-2).
DATABASE_MIGRATE_URL=

# Agents using @ferry/sdk (and examples/tripscout) read the Gate base URL from here.
FERRY_GATE_URL=http://localhost:3001
# Network the agent pays on: mainnet (default) or testnet. Must match the Gate's GATE_SUI_NETWORK.
FERRY_SUI_NETWORK=mainnet
# TripScout payer key and card live in examples/tripscout/.env.local (written by `pnpm keygen`):
# TRIPSCOUT_PRIVATE_KEY=suiprivkey1...   TRIPSCOUT_CARD_ID=<22 char card id>

# LLM providers for Distill and Desk. Server side only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENOKI_API_KEY=

# Session signing for SIWS-style wallet login (32+ random bytes, base64).
SESSION_SECRET=

# Public origin of the web app, used for extension externally_connectable and CSP.
NEXT_PUBLIC_FERRY_WEB_ORIGIN=http://localhost:3000

# Extension. The id is fixed by the `key` in apps/extension/manifest.config.ts (private half in
# apps/extension/.extension-key.pem, gitignored), so load-unpacked and the release ZIP match.
NEXT_PUBLIC_FERRY_EXTENSION_ID=opikbjojfgmdadhaljejplogjppfkhoh
# Extra extension ids (comma list) the chain proxy accepts, for forks with their own key.
FERRY_EXTENSION_IDS=
# Build time, extension only. The production web origin (https). The extension then accepts
# messages from it and from http://localhost:3000, and calls its API there.
FERRY_WEB_ORIGIN_PROD=https://ferry-memory.vercel.app
# Optional override of the API origin the extension calls (defaults to FERRY_WEB_ORIGIN_PROD,
# else http://localhost:3000).
FERRY_API_ORIGIN=

# Web app: Ferry Gate base URL for Share and Earn (SIWS sign in, cards, earnings).
NEXT_PUBLIC_GATE_URL=http://localhost:3001

# scripts/count-memories.ts: a delegate key of the main account, used only to count records
# with listMemories. Writes a number and a timestamp to Neon public_stats; never memory text.
FERRY_COUNT_ACCOUNT_ID=
FERRY_COUNT_DELEGATE_KEY=
