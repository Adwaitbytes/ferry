{
  "name": "ferry",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p scripts",
    "lint": "turbo run lint && eslint scripts/*.ts scripts/lib",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "redteam": "node scripts/redteam.mjs",
    "format": "prettier --write .",
    "copycheck": "node scripts/copycheck.mjs",
    "secretscan": "node scripts/bundle-keyscan.mjs",
    "publish-public": "tsx --env-file-if-exists=.env.local scripts/publish-public.ts",
    "count-memories": "tsx --env-file-if-exists=.env.local scripts/count-memories.ts",
    "e2e": "pnpm --filter @ferry/e2e run e2e",
    "dev": "turbo run dev --filter=@ferry/web --filter=@ferry/gate",
    "dev:extension": "pnpm --filter @ferry/extension dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ferry/core": "workspace:*",
    "@ferry/distill": "workspace:*",
    "@ferry/memwal": "workspace:*",
    "@ferry/pay": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-security": "4.2.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
